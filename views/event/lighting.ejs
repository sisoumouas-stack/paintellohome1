<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Éclairage — Paintello Home</title>
  <meta name="description" content="Découvrez notre collection d'éclairage — des lampes nées de nos vases, et des créations lumineuses uniques.">

  <link rel="stylesheet" href="/css/tailwind.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

  <% if (process.env.FB_PIXEL_ID) { %>
  <script>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
    n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
    document,'script','https://connect.facebook.net/en_US/fbevents.js');

    var pixelConfig = {};
    <% if (user && user.email) { %> pixelConfig.em = <%- JSON.stringify(user.email) %>; <% } %>
    <% if (user && user.firstName) { %> pixelConfig.fn = <%- JSON.stringify(user.firstName) %>; <% } %>
    <% if (user && user.lastName) { %> pixelConfig.ln = <%- JSON.stringify(user.lastName) %>; <% } %>
    <% if (user && user.numero) { %> pixelConfig.ph = <%- JSON.stringify(user.numero) %>; <% } %>
    <% if (user && user._id) { %> pixelConfig.external_id = <%- JSON.stringify(String(user._id)) %>; <% } %>

    fbq('init', '<%= process.env.FB_PIXEL_ID %>', pixelConfig);
    fbq('track', 'PageView', {}, { eventID: '<%= metaEventIdPageView %>' });
  </script>
  <% } %>

  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #111; }

    .site-nav a { font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; color: #333; }
    .site-nav a:hover { color: #000; }

    /* ===== HERO BANNER (URBAN BARN STYLE) ===== */
    .lighting-banner {
      position: relative;
      height: 70vh;
      min-height: 400px;
      overflow: hidden;
      margin-top: 0;               /* <-- FIXED: no negative margin, header is visible */
    }
    .lighting-banner-image {
      position: absolute;
      inset: 0;
      z-index: 1;
    }
    .lighting-banner-gif {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .lighting-banner-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, rgba(0,0,0,0.2), rgba(0,0,0,0.5));
      z-index: 2;
    }
    .lighting-banner-content {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 3;
      color: white;
      text-align: center;
      padding: 0 20px;
    }
    .lighting-banner-title {
      font-size: 2.5rem;
      font-weight: 300;
      letter-spacing: 3px;
      text-transform: uppercase;
      margin-bottom: 0.5rem;
    }
    .lighting-banner-subtitle {
      font-size: 1rem;
      font-weight: 300;
      letter-spacing: 1.5px;
      opacity: 0.95;
      max-width: 600px;
      margin-bottom: 2rem;
    }
    .lighting-banner-btn {
      display: inline-block;
      padding: 14px 32px;
      background: white;
      color: #111;
      text-decoration: none;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      transition: all 0.3s ease;
      border: 1px solid white;
    }
    .lighting-banner-btn:hover {
      background: transparent;
      color: white;
      border-color: white;
    }

    /* ===== FILTER BAR ===== */
    .filter-bar {
      display: flex;
      justify-content: center;
      gap: 20px;
      padding: 20px 0 10px;
      flex-wrap: wrap;
    }
    .filter-btn {
      background: none;
      border: none;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #666;
      cursor: pointer;
      padding: 8px 16px;
      transition: color 0.3s;
      border-bottom: 2px solid transparent;
    }
    .filter-btn.active {
      color: #000;
      border-bottom-color: #000;
      font-weight: 500;
    }
    .filter-btn:hover {
      color: #000;
    }

    /* ===== PRODUCT GRID ===== */
    .light-card { display: block; position: relative; }
    .light-card-img-wrap {
      position: relative;
      aspect-ratio: 1 / 1;
      overflow: hidden;
      background: #f7f7f5;
      border-radius: 2px;
    }
    .light-card-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: opacity 0.4s ease;
    }
    .light-card-img.secondary { opacity: 0; }
    .light-card:hover .light-card-img.primary { opacity: 0; }
    .light-card:hover .light-card-img.secondary { opacity: 1; }

    .light-card-badge {
      position: absolute;
      top: 12px;
      left: 12px;
      background: #000;
      color: #fff;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 4px 10px;
      border-radius: 2px;
      z-index: 2;
    }

    .light-card-title {
      font-size: 0.85rem;
      font-weight: 500;
      margin-top: 14px;
      margin-bottom: 4px;
    }
    .light-card-price { font-size: 0.85rem; color: #444; }
    .light-card-price .old { text-decoration: line-through; color: #aaa; margin-right: 6px; }

    /* Quick view overlay */
    .light-card-quickview {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(255,255,255,0.92);
      padding: 12px;
      transform: translateY(100%);
      transition: transform 0.3s ease;
      text-align: center;
      z-index: 3;
    }
    .light-card:hover .light-card-quickview {
      transform: translateY(0);
    }
    .light-card-quickview a {
      color: #111;
      text-decoration: none;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    /* Responsive adjustments for banner */
    @media (max-width: 768px) {
      .lighting-banner {
        height: 50vh;
        min-height: 300px;
      }
      .lighting-banner-title { font-size: 1.8rem; }
      .lighting-banner-subtitle { font-size: 0.85rem; margin-bottom: 1.5rem; }
      .lighting-banner-btn { padding: 12px 24px; font-size: 0.7rem; }
    }
    @media (max-width: 480px) {
      .lighting-banner {
        height: 40vh;
        min-height: 250px;
      }
      .lighting-banner-title { font-size: 1.5rem; }
      .lighting-banner-subtitle { font-size: 0.75rem; }
    }
  </style>
</head>
<body class="bg-white">

  <!-- ===================== HEADER ===================== -->
  <header class="border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-6 py-5 flex items-center justify-between">
      <a href="/"><img src="/img/logo.png" alt="Paintello Home" class="h-8"></a>
      <nav class="site-nav hidden md:flex items-center gap-8">
        <a href="/">Accueil</a>
        <a href="/shop">Boutique</a>
        <a href="/eclairage" class="text-black font-medium">Éclairage</a>
        <a href="/contact">Contact</a>
      </nav>
      <a href="/shop" aria-label="Panier"><i class="fas fa-shopping-bag text-lg"></i></a>
    </div>
  </header>

  <!-- ===================== HERO BANNER ===================== -->
  <section class="lighting-banner">
    <div class="lighting-banner-image">
      <img src="https://www.urbanbarn.com/on/demandware.static/-/Library-Sites-UrbanBarnCASharedLibrary/default/dw064ff548/images/2026/banner/fall-2026-lighting_2000x750.gif"
           alt="Collection Éclairage — Lampes et abat-jours"
           class="lighting-banner-gif" />
    </div>
    <div class="lighting-banner-overlay"></div>
    <div class="lighting-banner-content">
      <h1 class="lighting-banner-title">Éclairage</h1>
      <p class="lighting-banner-subtitle">
        Lampes nées de nos vases & créations lumineuses uniques
      </p>
      <a href="#lighting-grid" class="lighting-banner-btn">Découvrir la collection</a>
    </div>
  </section>

  <!-- ===================== FILTER BAR ===================== -->
  <div class="filter-bar">
    <button class="filter-btn active" data-filter="all">Toutes les lampes</button>
    <button class="filter-btn" data-filter="vase">Nées d'un vase</button>
    <!-- Optionally add more filters here -->
  </div>

  <!-- ===================== PRODUCT GRID ===================== -->
  <section id="lighting-grid" class="max-w-7xl mx-auto px-6 pb-24">
    <% if (!lightingProducts || lightingProducts.length === 0) { %>
      <div class="text-center py-20">
        <p class="text-sm text-gray-500">Notre collection d'éclairage arrive bientôt.</p>
        <a href="/shop" class="inline-block mt-4 text-xs uppercase tracking-widest underline">Voir la boutique</a>
      </div>
    <% } else { %>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-12">
        <% lightingProducts.forEach(function(p) { %>
          <a href="/producthome/<%= p._id %>" class="light-card" data-vase="<%= p.baseVaseId ? 'true' : 'false' %>">
            <div class="light-card-img-wrap">
              <% if (p.baseVaseId) { %>
                <span class="light-card-badge">Née d'un vase</span>
              <% } %>
              <img class="light-card-img primary"
                   src="<%= (p.image && p.image[0]) || '/img/logo.png' %>"
                   alt="<%= p.title %>">
              <% if (p.image && p.image[1]) { %>
                <img class="light-card-img secondary" src="<%= p.image[1] %>" alt="<%= p.title %> — en situation">
              <% } %>
              <div class="light-card-quickview">
                <span>Aperçu rapide</span>
              </div>
            </div>
            <p class="light-card-title"><%= p.title %></p>
            <p class="light-card-price">
              <% if (p.oldPrice) { %><span class="old"><%= p.oldPrice %> DZD</span><% } %>
              <%= p.price %> DZD
            </p>
          </a>
        <% }); %>
      </div>
    <% } %>
  </section>

  <!-- ===================== FOOTER ===================== -->
  <footer class="footer-zara">
    <div class="max-w-7xl mx-auto">
      <p>© <%= new Date().getFullYear() %> Paintello Home — All rights reserved</p>
    </div>
  </footer>

  <!-- ===================== JAVASCRIPT ===================== -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Filter functionality
      const filterButtons = document.querySelectorAll('.filter-btn');
      const productCards = document.querySelectorAll('.light-card');

      filterButtons.forEach(btn => {
        btn.addEventListener('click', function() {
          // Update active button
          filterButtons.forEach(b => b.classList.remove('active'));
          this.classList.add('active');

          const filter = this.dataset.filter;
          productCards.forEach(card => {
            if (filter === 'all') {
              card.style.display = 'block';
            } else if (filter === 'vase') {
              card.style.display = card.dataset.vase === 'true' ? 'block' : 'none';
            }
          });
        });
      });
    });
  </script>
</body>
</html>
